# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# MongoDB connection string (MongoDB Atlas recommended). Leave unset locally to use an in-memory database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/budget_monitor?retryWrites=true&w=majority

# Secret used to sign login tokens. Use a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to trigger the daily monitoring scan.
CRON_SECRET=change-me-too

# Seed reference data automatically on first start when the database is empty (true/false).
AUTO_SEED=true

# Optional: comma-separated list of allowed origins for the API (defaults to same-origin/any).
# CORS_ORIGIN=https://your-app.vercel.app

PORT=3000
