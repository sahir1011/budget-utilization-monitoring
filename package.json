{
  "name": "budget-utilization-monitoring",
  "version": "1.0.0",
  "description": "AI-Based Budget Utilization Monitoring System (MEAN stack)",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon --watch server server/dev.js",
    "dev:web": "npm --prefix client start",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node server/seed/cli.js",
    "seed:reset": "node server/seed/cli.js --reset",
    "test": "node --test --test-concurrency=1 \"server/tests/*.test.js\""
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.19"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
